#compdef pdfx

autoload -U is-at-least

_pdfx() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-d[Enable verbose debug logging]' \
'--debug[Enable verbose debug logging]' \
'--json[Output result in machine-readable JSON format]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_pdfx_commands" \
"*::: :->pdfx" \
&& ret=0
    case $state in
    (pdfx)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:pdfx-command-$line[1]:"
        case $line[1] in
            (open)
_arguments "${_arguments_options[@]}" : \
'-d[Enable verbose debug logging]' \
'--debug[Enable verbose debug logging]' \
'--json[Output result in machine-readable JSON format]' \
'-h[Print help]' \
'--help[Print help]' \
'::file -- Path to the PDF file to open:_files' \
&& ret=0
;;
(info)
_arguments "${_arguments_options[@]}" : \
'-d[Enable verbose debug logging]' \
'--debug[Enable verbose debug logging]' \
'--json[Output result in machine-readable JSON format]' \
'-h[Print help]' \
'--help[Print help]' \
':file -- Path to the PDF file:_files' \
&& ret=0
;;
(merge)
_arguments "${_arguments_options[@]}" : \
'-o+[Target destination output file]:OUTPUT:_files' \
'--output=[Target destination output file]:OUTPUT:_files' \
'-d[Enable verbose debug logging]' \
'--debug[Enable verbose debug logging]' \
'--json[Output result in machine-readable JSON format]' \
'-h[Print help]' \
'--help[Print help]' \
'*::files -- List of PDF files to merge (at least 2):_files' \
&& ret=0
;;
(split)
_arguments "${_arguments_options[@]}" : \
'-p+[Page range (e.g. '\''1-5'\'', '\''1,3,5'\'', '\''odd'\'', '\''even'\'')]:PAGES:_default' \
'--pages=[Page range (e.g. '\''1-5'\'', '\''1,3,5'\'', '\''odd'\'', '\''even'\'')]:PAGES:_default' \
'-o+[Destination directory for split files (defaults to current dir)]:OUTPUT_DIR:_files' \
'--output-dir=[Destination directory for split files (defaults to current dir)]:OUTPUT_DIR:_files' \
'-d[Enable verbose debug logging]' \
'--debug[Enable verbose debug logging]' \
'--json[Output result in machine-readable JSON format]' \
'-h[Print help]' \
'--help[Print help]' \
':file -- Path to the PDF file to split:_files' \
&& ret=0
;;
(extract)
_arguments "${_arguments_options[@]}" : \
'-p+[Page range to extract (e.g. '\''1-3'\'', '\''5,8'\'')]:PAGES:_default' \
'--pages=[Page range to extract (e.g. '\''1-3'\'', '\''5,8'\'')]:PAGES:_default' \
'-o+[Target output PDF file]:OUTPUT:_files' \
'--output=[Target output PDF file]:OUTPUT:_files' \
'-d[Enable verbose debug logging]' \
'--debug[Enable verbose debug logging]' \
'--json[Output result in machine-readable JSON format]' \
'-h[Print help]' \
'--help[Print help]' \
':file -- Path to the PDF file:_files' \
&& ret=0
;;
(rotate)
_arguments "${_arguments_options[@]}" : \
'-p+[Page range to rotate ('\''all'\'', '\''1-5'\'', '\''odd'\'')]:PAGES:_default' \
'--pages=[Page range to rotate ('\''all'\'', '\''1-5'\'', '\''odd'\'')]:PAGES:_default' \
'-a+[Rotation angle in degrees\: 90, 180, or 270]:DEGREES:_default' \
'--degrees=[Rotation angle in degrees\: 90, 180, or 270]:DEGREES:_default' \
'-o+[Target output PDF file]:OUTPUT:_files' \
'--output=[Target output PDF file]:OUTPUT:_files' \
'-d[Enable verbose debug logging]' \
'--debug[Enable verbose debug logging]' \
'--json[Output result in machine-readable JSON format]' \
'-h[Print help]' \
'--help[Print help]' \
':file -- Path to the PDF file:_files' \
&& ret=0
;;
(delete)
_arguments "${_arguments_options[@]}" : \
'-p+[Page range to delete (e.g. '\''1,3'\'', '\''5-10'\'')]:PAGES:_default' \
'--pages=[Page range to delete (e.g. '\''1,3'\'', '\''5-10'\'')]:PAGES:_default' \
'-o+[Target output PDF file]:OUTPUT:_files' \
'--output=[Target output PDF file]:OUTPUT:_files' \
'-y[Confirm deletion without interactive prompt]' \
'--yes[Confirm deletion without interactive prompt]' \
'-d[Enable verbose debug logging]' \
'--debug[Enable verbose debug logging]' \
'--json[Output result in machine-readable JSON format]' \
'-h[Print help]' \
'--help[Print help]' \
':file -- Path to the PDF file:_files' \
&& ret=0
;;
(reorder)
_arguments "${_arguments_options[@]}" : \
'-s+[New page order as comma-separated 1-indexed numbers (e.g. '\''3,1,2,4'\'')]:ORDER:_default' \
'--order=[New page order as comma-separated 1-indexed numbers (e.g. '\''3,1,2,4'\'')]:ORDER:_default' \
'-o+[Target output PDF file]:OUTPUT:_files' \
'--output=[Target output PDF file]:OUTPUT:_files' \
'-d[Enable verbose debug logging]' \
'--debug[Enable verbose debug logging]' \
'--json[Output result in machine-readable JSON format]' \
'-h[Print help]' \
'--help[Print help]' \
':file -- Path to the PDF file:_files' \
&& ret=0
;;
(text)
_arguments "${_arguments_options[@]}" : \
'-p+[Page range to extract ('\''all'\'', '\''1-5'\'', '\''odd'\'')]:PAGES:_default' \
'--pages=[Page range to extract ('\''all'\'', '\''1-5'\'', '\''odd'\'')]:PAGES:_default' \
'-f+[Output text format\: '\''plain'\'', '\''json'\'', or '\''jsonl'\'']:FORMAT:_default' \
'--format=[Output text format\: '\''plain'\'', '\''json'\'', or '\''jsonl'\'']:FORMAT:_default' \
'-o+[Destination file for text (prints to stdout if omitted)]:OUTPUT:_files' \
'--output=[Destination file for text (prints to stdout if omitted)]:OUTPUT:_files' \
'-d[Enable verbose debug logging]' \
'--debug[Enable verbose debug logging]' \
'--json[Output result in machine-readable JSON format]' \
'-h[Print help]' \
'--help[Print help]' \
':file -- Path to the PDF file:_files' \
&& ret=0
;;
(compress)
_arguments "${_arguments_options[@]}" : \
'-o+[Target compressed output file]:OUTPUT:_files' \
'--output=[Target compressed output file]:OUTPUT:_files' \
'-d[Enable verbose debug logging]' \
'--debug[Enable verbose debug logging]' \
'--json[Output result in machine-readable JSON format]' \
'-h[Print help]' \
'--help[Print help]' \
':file -- Path to the PDF file to compress:_files' \
&& ret=0
;;
(ocr)
_arguments "${_arguments_options[@]}" : \
'-l+[OCR language (e.g. '\''eng'\'', '\''ind'\'', '\''eng+ind'\'')]:LANG:_default' \
'--lang=[OCR language (e.g. '\''eng'\'', '\''ind'\'', '\''eng+ind'\'')]:LANG:_default' \
'-p+[Page range to perform OCR on]:PAGES:_default' \
'--pages=[Page range to perform OCR on]:PAGES:_default' \
'-o+[Target output searchable PDF]:OUTPUT:_files' \
'--output=[Target output searchable PDF]:OUTPUT:_files' \
'-d[Enable verbose debug logging]' \
'--debug[Enable verbose debug logging]' \
'--json[Output result in machine-readable JSON format]' \
'-h[Print help]' \
'--help[Print help]' \
':file -- Path to the PDF file:_files' \
&& ret=0
;;
(clean)
_arguments "${_arguments_options[@]}" : \
'--history[Clear recent opened files history]' \
'--cache[Clear cached metadata and temporary files]' \
'--all[Clear all recent files, history, and cache]' \
'-d[Enable verbose debug logging]' \
'--debug[Enable verbose debug logging]' \
'--json[Output result in machine-readable JSON format]' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
'-d[Enable verbose debug logging]' \
'--debug[Enable verbose debug logging]' \
'--json[Output result in machine-readable JSON format]' \
'-h[Print help]' \
'--help[Print help]' \
':shell -- Target shell:(bash elvish fish powershell zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_pdfx__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:pdfx-help-command-$line[1]:"
        case $line[1] in
            (open)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(info)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(merge)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(split)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(extract)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(rotate)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(delete)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(reorder)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(text)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(compress)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(ocr)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(clean)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_pdfx_commands] )) ||
_pdfx_commands() {
    local commands; commands=(
'open:Open interactive PDF TUI viewer' \
'info:Inspect document metadata, version, encryption, and page dimensions' \
'merge:Merge multiple PDF files into a single document' \
'split:Split a PDF document into page ranges or individual parts' \
'extract:Extract specific pages from a PDF into a new document' \
'rotate:Rotate pages in a PDF document' \
'delete:Delete specific pages from a PDF document' \
'reorder:Reorder pages in a PDF document' \
'text:Extract text content from a PDF document' \
'compress:Optimize and compress PDF document streams' \
'ocr:Run OCR on scanned PDF pages to generate searchable document' \
'clean:Clean recent files and job history cache' \
'completions:Generate shell completion scripts (bash, zsh, fish, powershell)' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'pdfx commands' commands "$@"
}
(( $+functions[_pdfx__subcmd__clean_commands] )) ||
_pdfx__subcmd__clean_commands() {
    local commands; commands=()
    _describe -t commands 'pdfx clean commands' commands "$@"
}
