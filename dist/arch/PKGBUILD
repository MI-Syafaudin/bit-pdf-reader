# Maintainer: MI_Syafaudin <https://github.com/MI-Syafaudin>
# Contributors: Bit PDF Reader Contributors
pkgname=bit-pdf
_binname=pdfx
pkgver=0.1.0
pkgrel=1
pkgdesc="Bit PDF Reader — High-performance Terminal & CLI PDF Swiss Army Knife for Linux"
arch=('x86_64' 'aarch64')
url="https://github.com/MI-Syafaudin/bit-pdf-reader"
license=('Apache-2.0')
depends=('gcc-libs')
optdepends=(
    'tesseract: OCR support for scanned documents'
    'tesseract-data-eng: English traineddata for OCR'
    'tesseract-data-ind: Indonesian traineddata for OCR'
)
provides=('pdfx')
conflicts=('pdfx')
makedepends=('cargo' 'git')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --all-targets
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --release --workspace
}

package() {
    cd "$pkgname-$pkgver"

    # Install binaries
    install -Dm755 target/release/bit-pdf "$pkgdir/usr/bin/bit-pdf"
    install -Dm755 target/release/pdfx "$pkgdir/usr/bin/pdfx"

    # Install manpages
    install -Dm644 man/bit-pdf.1 "$pkgdir/usr/share/man/man1/bit-pdf.1"
    install -Dm644 man/pdfx.1 "$pkgdir/usr/share/man/man1/pdfx.1"

    # Install desktop entries
    install -Dm644 dist/bit-pdf.desktop "$pkgdir/usr/share/applications/bit-pdf.desktop"
    install -Dm644 dist/pdfx.desktop "$pkgdir/usr/share/applications/pdfx.desktop"

    # Install shell completions
    install -Dm644 completions/bit-pdf.bash "$pkgdir/usr/share/bash-completion/completions/bit-pdf"
    install -Dm644 completions/pdfx.bash "$pkgdir/usr/share/bash-completion/completions/pdfx"
    install -Dm644 completions/_bit-pdf "$pkgdir/usr/share/zsh/site-functions/_bit-pdf"
    install -Dm644 completions/_pdfx "$pkgdir/usr/share/zsh/site-functions/_pdfx"
    install -Dm644 completions/bit-pdf.fish "$pkgdir/usr/share/fish/vendor_completions.d/bit-pdf.fish"
    install -Dm644 completions/pdfx.fish "$pkgdir/usr/share/fish/vendor_completions.d/pdfx.fish"

    # Install license
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
