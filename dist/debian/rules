#!/usr/bin/make -f
export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked

override_dh_auto_test:
	cargo test --release --locked --workspace

override_dh_auto_install:
	install -Dm755 target/release/bit-pdf debian/bit-pdf/usr/bin/bit-pdf
	install -Dm755 target/release/pdfx debian/bit-pdf/usr/bin/pdfx
	install -Dm644 man/bit-pdf.1 debian/bit-pdf/usr/share/man/man1/bit-pdf.1
	install -Dm644 man/pdfx.1 debian/bit-pdf/usr/share/man/man1/pdfx.1
	install -Dm644 dist/bit-pdf.desktop debian/bit-pdf/usr/share/applications/bit-pdf.desktop
	install -Dm644 dist/pdfx.desktop debian/bit-pdf/usr/share/applications/pdfx.desktop
	install -Dm644 completions/bit-pdf.bash debian/bit-pdf/usr/share/bash-completion/completions/bit-pdf
	install -Dm644 completions/pdfx.bash debian/bit-pdf/usr/share/bash-completion/completions/pdfx
	install -Dm644 completions/_bit-pdf debian/bit-pdf/usr/share/zsh/vendor-completions/_bit-pdf
	install -Dm644 completions/_pdfx debian/bit-pdf/usr/share/zsh/vendor-completions/_pdfx
	install -Dm644 completions/bit-pdf.fish debian/bit-pdf/usr/share/fish/vendor_completions.d/bit-pdf.fish
	install -Dm644 completions/pdfx.fish debian/bit-pdf/usr/share/fish/vendor_completions.d/pdfx.fish
